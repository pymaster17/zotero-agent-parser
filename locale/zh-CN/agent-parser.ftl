agentparser-name = Agent Parser

agentparser-menu-parse =
    .label = 解析 PDF 为 Agent 可读格式
agentparser-menu-reparse =
    .label = 强制重新解析 PDF
agentparser-menu-parse-cloud =
    .label = 用云端服务重新解析 PDF
agentparser-menu-parse-local =
    .label = 用本地 MinerU 重新解析 PDF
agentparser-menu-reveal =
    .label = 显示解析结果
agentparser-menu-parse-library =
    .label = 解析当前库中所有未解析的 PDF…

agentparser-notify-success = PDF 解析完成
agentparser-notify-failure = PDF 解析失败
agentparser-notify-batch = 批量解析完成
agentparser-notify-batch-result = 成功 { $done } 篇，失败 { $failed } 篇（失败原因见「帮助 → 调试输出日志」或错误控制台）
agentparser-notify-queued = 已加入解析队列：{ $count } 个 PDF
agentparser-alert-not-parsed = 所选条目还没有解析结果。
agentparser-alert-library-done = 当前库中的 PDF 都已解析。
agentparser-confirm-library = 将有 { $count } 个 PDF 提交到云端解析，会消耗解析额度，是否继续？
agentparser-confirm-library-local = 将有 { $count } 个 PDF 由本地 MinerU 逐个解析。Apple Silicon 上 standard 档约 1 分钟一篇（advanced 档更久），是否继续？

agentparser-pref-mode = 解析方式
agentparser-mode-cloud =
    .label = 云端（mineru.net）
agentparser-mode-local =
    .label = 本地（在本机运行 MinerU）
agentparser-pref-mode-desc = 新条目使用这里选择的方式解析。也可以在条目右键菜单中指定用云端或本地重新解析。
agentparser-pref-bulk-cloud =
    .label = 本地模式下，大批量请求（整库解析、多选条目）使用云端批处理接口
agentparser-warn-no-token = 请在下方填写云端 API Token，或改用本地解析。
agentparser-warn-bulk-no-token = 未配置云端 API Token，大批量请求也将在本地解析。

agentparser-pref-cloud = 云端
agentparser-pref-cloud-desc = 在 mineru.net 的 API 管理页面申请 Token。单个文件不超过 200 MB / 200 页。
agentparser-pref-token = API Token：
agentparser-pref-model-version = 模型版本：
agentparser-pref-language = 文档语言：
agentparser-pref-url-hosts = URL 直传域名：
agentparser-pref-url-hosts-desc = 来自这些域名（逗号分隔，含子域名）的 PDF 会把下载地址交给 MinerU 直接下载，不再上传本地文件；地址不可用或文件与本地不一致时自动改为上传。
agentparser-pref-concurrency = 并发任务数：
agentparser-pref-url = 服务地址：
agentparser-pref-force-ocr =
    .label = 强制 OCR
agentparser-pref-formula =
    .label = 识别公式
agentparser-pref-table =
    .label = 识别表格
agentparser-pref-test =
    .label = 测试连接

agentparser-pref-local = 本地
agentparser-pref-tier = 解析档位：
agentparser-tier-basic =
    .label = basic
agentparser-tier-standard =
    .label = standard（推荐）
agentparser-tier-advanced =
    .label = advanced
agentparser-tier-desc-basic = 只用小模型，不用 VLM。最快、内存占用最小，但公式和复杂版面的质量最低。
agentparser-tier-desc-standard = 小模型做版面分析，MinerU2.5 VLM 识别文本、公式和表格。M4 + MLX 上约 3.5 秒/页，普通论文 1 分钟以内。
agentparser-tier-desc-advanced = 版面也交给 VLM。表格多、版面复杂的文档质量更好，但比 standard 慢约 4 倍（M4 上约 13 秒/页）。
agentparser-pref-ocr-mode = OCR 模式：
agentparser-pref-managed =
    .label = 由 Agent Parser 安装并运行 MinerU（取消勾选可连接自己运行的服务）
agentparser-local-env = 环境：
agentparser-local-models = 模型：
agentparser-local-server = 服务：
agentparser-local-env-ok = MinerU { $version }（{ $engine }），位于 { $dir }
agentparser-local-env-missing = 未安装
agentparser-local-step-starting = 准备中…
agentparser-local-step-venv = 正在创建 Python 环境…（{ $minutes } 分钟）
agentparser-local-step-packages = 正在安装 MinerU 及依赖…（{ $minutes } 分钟）
agentparser-local-step-models = 正在下载模型…（{ $minutes } 分钟）
agentparser-local-unknown = —
agentparser-local-models-ok = { $tier } 档所需模型已就绪
agentparser-local-models-missing = 缺少 { $tier } 档所需模型，请点击「安装」
agentparser-local-server-running = 运行中（PID { $pid }，{ $url }）
agentparser-local-server-starting = 正在启动…
agentparser-local-server-stopped = 未运行（需要时自动启动）
agentparser-local-install =
    .label = 安装
agentparser-local-update =
    .label = 更新 / 修复
agentparser-local-cancel =
    .label = 取消
agentparser-local-start =
    .label = 启动服务
agentparser-local-stop =
    .label = 停止服务
agentparser-local-starting-hint = 正在启动本地 MinerU 服务（加载模型需要一点时间）…
agentparser-local-install-confirm = 将把 MinerU 安装到 { $dir } 并下载模型，共约 { $size } GB，需要一段时间。是否继续？
agentparser-pref-env-dir = 环境目录：
agentparser-pref-uv-path = uv 路径：
agentparser-pref-model-source = 模型来源：
agentparser-pref-port = 端口：
agentparser-pref-idle-stop = 空闲多久后停止服务（分钟，0 为不停止）：
agentparser-pref-external-desc = 自行运行 `mineru-kit api-server`（本机或其他电脑均可），在这里填写地址；若启动时设置了 --api-key，请一并填写。
agentparser-pref-api-key = API Key：

agentparser-pref-general = 常规
agentparser-pref-auto-parse =
    .label = 添加新条目时自动解析 PDF
agentparser-pref-skip-synced =
    .label = 跳过从同步下载的条目（由添加它的电脑负责解析）
agentparser-pref-include-linked =
    .label = 同时解析链接文件（结果写在 PDF 旁的文件夹中，不经 Zotero 同步）
agentparser-pref-notifications =
    .label = 解析完成或失败时显示通知
agentparser-pref-timeout = 单个任务超时（分钟）：
agentparser-pref-wait-file = 等待 PDF 下载完成（分钟）：

agentparser-pref-output = 解析产物
agentparser-pref-output-desc = 产物保存在 PDF 所在的附件目录（storage/<附件键>/<文件夹名>/）中，只有 full.md 和 images/ 两项。full.md 开头的 YAML 记录了标题、作者、DOI、Zotero 链接和源 PDF 的哈希。WebDAV 同步会把整个附件目录一起上传；Zotero 自带存储只上传 PDF 本身。
agentparser-pref-dir-name = 产物文件夹名：
agentparser-pref-success-tag = 解析成功后添加标签：
agentparser-pref-mark-sync =
    .label = 解析完成后标记附件待上传，使 WebDAV 把产物同步到其他电脑

agentparser-pref-queue = 队列
agentparser-pref-queue-status = 排队 { $queued } 个，进行中 { $running } 个{ $details }
agentparser-pref-clear-queue =
    .label = 清空队列
